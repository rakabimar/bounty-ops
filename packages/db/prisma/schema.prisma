generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Program {
  id                  String               @id @default(cuid())
  platform            String
  name                String
  handle              String?
  programUrl          String?
  status              String               @default("active")
  huntingStatus       String               @default("ongoing")
  intakeSource        String?
  rawPolicyText       String?
  policyHash          String?
  lastSyncedAt        DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  scopes              ProgramScope[]
  rules               ProgramRules?
  headers             ProgramHeader[]
  auditLogs           AuditLog[]
  assets              Asset[]
  dnsRecords          DnsRecord[]
  httpServices        HttpService[]
  urls                Url[]
  apiEndpoints        ApiEndpoint[]
  scannerFindings     ScannerFinding[]
  researchNotes       ResearchNote[]
  manualChecklists    ManualChecklist[]
  interestingRequests InterestingRequest[]
  evidenceItems       EvidenceItem[]
  jobs                Job[]
  scopeGuardChecks    ScopeGuardCheck[]
}

model ProgramScope {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  asset           String
  normalizedAsset String
  assetType       String
  isInScope       Boolean
  bountyEligible  Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([programId])
}

model ProgramRules {
  id                 String   @id @default(cuid())
  programId          String   @unique
  program            Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  automationAllowed  String   @default("unknown")
  aggressiveAllowed  Boolean  @default(false)
  rateLimitRps       Int?
  maxConcurrency     Int?
  forbiddenActions   Json?
  authTestingAllowed Boolean  @default(false)
  dosTestingAllowed  Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProgramHeader {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name       String
  value      String
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([programId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  programId  String?
  program    Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([programId])
  @@index([userId])
  @@index([createdAt])
}

model Asset {
  id              String           @id @default(cuid())
  programId       String
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  type            String
  value           String
  normalizedValue String
  parentAssetId   String?
  scopeStatus     String           @default("unknown")
  status          String           @default("new")
  autoScore       Int              @default(0)
  manualScore     Int?
  finalScore      Int              @default(0)
  confidence      Int              @default(0)
  categories      Json?
  reasonTags      Json?
  sourceTools     Json?
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  lastChangedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dnsRecords      DnsRecord[]
  httpServices    HttpService[]
  urls            Url[]
  endpoints       ApiEndpoint[]
  scannerFindings ScannerFinding[]

  @@unique([programId, type, normalizedValue])
  @@index([programId])
}

model DnsRecord {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  host        String
  recordType  String
  value       String
  ttl         Int?
  resolver    String?
  sourceTool  String   @default("dnsx")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([programId, host, recordType, value])
  @@index([programId])
  @@index([host])
  @@index([recordType])
  @@index([value])
}

model HttpService {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  url             String
  normalizedUrl   String
  scheme          String?
  host            String
  port            Int?
  statusCode      Int?
  title           String?
  webserver       String?
  technologies    Json?
  contentLength   Int?
  responseTimeMs  Int?
  contentType     String?
  location        String?
  cdnName         String?
  titleHash       String?
  fingerprintHash String?
  failed          Boolean  @default(false)
  sourceTool      String   @default("httpx")
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  urls            Url[]

  @@unique([programId, normalizedUrl])
  @@index([programId])
  @@index([host])
}

model Url {
  id               String           @id @default(cuid())
  programId        String
  program          Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  assetId          String?
  asset            Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  httpServiceId    String?
  httpService      HttpService?     @relation(fields: [httpServiceId], references: [id], onDelete: SetNull)
  url              String
  normalizedUrl    String
  scheme           String?
  host             String
  port             Int?
  path             String?
  queryParamKeys   Json?
  title            String?
  statusCode       Int?
  contentType      String?
  contentLength    Int?
  responseTimeMs   Int?
  redirectLocation String?
  technologies     Json?
  server           String?
  categories       Json?
  reasonTags       Json?
  sourceTools      Json?
  scopeStatus      String           @default("unknown")
  status           String           @default("new")
  autoScore        Int              @default(0)
  manualScore      Int?
  finalScore       Int              @default(0)
  confidence       Int              @default(0)
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  lastReviewedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  endpoints        ApiEndpoint[]
  scannerFindings  ScannerFinding[]

  @@unique([programId, normalizedUrl])
  @@index([programId])
  @@index([assetId])
  @@index([httpServiceId])
  @@index([host])
  @@index([status])
  @@index([finalScore])
}

model ApiEndpoint {
  id                String              @id @default(cuid())
  programId         String
  program           Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  assetId           String?
  asset             Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  urlId             String?
  url               Url?                @relation(fields: [urlId], references: [id], onDelete: SetNull)
  method            String              @default("UNKNOWN")
  path              String
  fullUrl           String
  normalizedFullUrl String
  statusCode        Int?
  contentType       String?
  authRequired      String              @default("unknown")
  source            String              @default("manual")
  status            String              @default("new")
  categories        Json?
  reasonTags        Json?
  autoScore         Int                 @default(0)
  manualScore       Int?
  finalScore        Int                 @default(0)
  confidence        Int                 @default(0)
  notesCount        Int                 @default(0)
  firstSeenAt       DateTime            @default(now())
  lastSeenAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  parameters        EndpointParameter[]
  scannerFindings   ScannerFinding[]

  @@unique([programId, method, normalizedFullUrl])
  @@index([programId])
  @@index([assetId])
  @@index([urlId])
  @@index([method])
  @@index([statusCode])
  @@index([finalScore])
}

model EndpointParameter {
  id           String      @id @default(cuid())
  endpointId   String
  endpoint     ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  name         String
  location     String
  exampleValue String?
  source       String?
  interesting  Boolean     @default(false)
  frequency    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([endpointId, name, location])
  @@index([endpointId])
  @@index([name])
  @@index([location])
  @@index([interesting])
}

model ScannerFinding {
  id               String       @id @default(cuid())
  programId        String
  program          Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  assetId          String?
  asset            Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  urlId            String?
  url              Url?         @relation(fields: [urlId], references: [id], onDelete: SetNull)
  endpointId       String?
  endpoint         ApiEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  tool             String       @default("manual")
  severity         String       @default("info")
  templateId       String?
  name             String
  description      String?
  matcher          String?
  matchedUrl       String?
  evidenceSnippet  String?
  extractedResults Json?
  status           String       @default("new")
  firstSeenAt      DateTime     @default(now())
  lastSeenAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([programId])
  @@index([assetId])
  @@index([urlId])
  @@index([endpointId])
  @@index([tool])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model ScoreEvent {
  id         String   @id @default(cuid())
  programId  String
  entityType String
  entityId   String
  ruleId     String?
  ruleName   String?
  reasonTag  String
  scoreDelta Int
  matched    Boolean  @default(true)
  evidence   Json?
  source     String   @default("scoring_engine")
  createdAt  DateTime @default(now())

  @@index([programId])
  @@index([entityType, entityId])
  @@index([reasonTag])
  @@index([createdAt])
}

model EntityClassification {
  id         String   @id @default(cuid())
  programId  String
  entityType String
  entityId   String
  category   String
  confidence Int      @default(0)
  source     String
  evidence   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, category])
  @@index([programId])
  @@index([category])
  @@index([entityType, entityId])
}

model EntityChange {
  id         String   @id @default(cuid())
  programId  String
  entityType String
  entityId   String
  type       String
  summary    String
  oldValue   String?
  newValue   String?
  source     String
  importance String   @default("low")
  createdAt  DateTime @default(now())

  @@index([programId])
  @@index([entityType, entityId])
  @@index([type])
  @@index([createdAt])
}

model ResearchNote {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  title           String?
  body            String
  tags            Json?
  pinned          Boolean  @default(false)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([programId])
  @@index([entityType, entityId])
  @@index([pinned])
  @@index([createdAt])
}

model ManualChecklist {
  id         String          @id @default(cuid())
  programId  String
  program    Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  title      String
  source     String          @default("manual")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      ChecklistItem[]

  @@index([programId])
  @@index([entityType, entityId])
  @@index([source])
}

model ChecklistItem {
  id                String          @id @default(cuid())
  checklistId       String
  checklist         ManualChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          String?
  status            String          @default("todo")
  priority          String          @default("medium")
  order             Int             @default(0)
  source            String          @default("manual")
  evidenceRef       String?
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([checklistId])
  @@index([status])
  @@index([priority])
  @@index([source])
}

model InterestingRequest {
  id                  String   @id @default(cuid())
  programId           String
  program             Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  entityType          String
  entityId            String
  method              String?
  url                 String?
  requestHeaders      Json?
  requestBody         String?
  responseStatus      Int?
  responseHeaders     Json?
  responseBodySnippet String?
  notes               String?
  tags                Json?
  source              String   @default("manual")
  createdByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([programId])
  @@index([entityType, entityId])
  @@index([method])
  @@index([responseStatus])
  @@index([createdAt])
}

model EvidenceItem {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  title           String
  evidenceType    String
  content         String?
  filePath        String?
  url             String?
  notes           String?
  tags            Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([programId])
  @@index([entityType, entityId])
  @@index([evidenceType])
  @@index([createdAt])
}

model EntityStatusTransition {
  id              String   @id @default(cuid())
  programId       String
  entityType      String
  entityId        String
  oldStatus       String?
  newStatus       String
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([programId])
  @@index([entityType, entityId])
  @@index([newStatus])
  @@index([createdAt])
}

model Job {
  id                 String   @id @default(cuid())
  programId          String?
  program            Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  type               String
  status             String   @default("queued")
  stage              String?
  target             String?
  config             Json?
  requestedByUserId  String?
  manualApproved     Boolean  @default(false)
  scopeGuardDecision Json?
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  runs               JobRun[]

  @@index([programId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model JobRun {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  programId     String?
  type          String
  status        String    @default("queued")
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  error         String?
  logs          Json?
  resultSummary Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  toolRuns      ToolRun[]

  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model ToolRun {
  id          String    @id @default(cuid())
  jobRunId    String
  jobRun      JobRun    @relation(fields: [jobRunId], references: [id], onDelete: Cascade)
  toolName    String
  command     String?
  args        Json?
  status      String    @default("queued")
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  stdoutPath  String?
  stderrPath  String?
  parsedCount Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobRunId])
  @@index([status])
}

model ScopeGuardCheck {
  id                       String   @id @default(cuid())
  programId                String?
  program                  Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  userId                   String?
  target                   String
  normalizedTarget         Json?
  jobType                  String
  stage                    String
  decision                 String
  allowed                  Boolean
  reasons                  Json
  matchedInScopeScopeId    String?
  matchedOutOfScopeScopeId String?
  effectiveRateLimitRps    Int?
  effectiveMaxConcurrency  Int?
  requiredHeaders          Json?
  createdAt                DateTime @default(now())

  @@index([programId])
  @@index([decision])
  @@index([jobType])
  @@index([createdAt])
}
