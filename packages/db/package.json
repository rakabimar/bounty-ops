{
  "name": "@bountyops/db",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "build": "tsc",
    "lint": "echo \"No database lint configuration yet\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "dotenv-cli": "latest",
    "prisma": "6.19.3",
    "tsx": "latest",
    "typescript": "latest"
  }
}
